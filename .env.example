# 이 파일을 `.env`로 복사한 뒤 값을 채우세요. `.env`는 .gitignore에 걸려 있습니다.
# mobile-web과 projector-web은 같은 Supabase 프로젝트를 바라보며,
# 두 앱의 vite.config.ts가 envDir을 레포 루트로 잡고 있어 .env는 여기 한 벌이면 됩니다.
# (Vercel 등에 배포할 때는 각 프로젝트 대시보드의 환경변수로 주입합니다.)

# ---------------------------------------------------------------------------
# ⚠️ VITE_ 접두사가 붙은 값은 빌드 시 번들에 문자열로 박혀 누구나 볼 수 있습니다.
#    아래 두 값은 원래 공개되는 값이라 괜찮지만,
#    service_role 키나 Personal Access Token에는 절대 VITE_를 붙이지 마세요.
#    실제 보안은 키가 아니라 supabase/migrations의 RLS 정책이 담당합니다.
# ---------------------------------------------------------------------------

# Supabase 대시보드 > 프로젝트 설정 > Data API / API Keys
# anon(publishable) 키를 넣습니다. secret 키를 넣으면 앱 실행 시점에 에러가 납니다.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-publishable-key>

# `pnpm gen:db-types` 에서만 쓰이는 값. 프로젝트 참조 문자열이라 비밀은 아닙니다.
SUPABASE_PROJECT_ID=<project-ref>
